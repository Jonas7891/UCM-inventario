{
  "name": "universal-camisas-motores",
  "version": "1.0.0",
  "description": "Sistema de inventario y gestión de precios - Universal de Camisas para Motores",
  "main": "main.js",
  "author": "Jonattan",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "start:api": "node backend/server.js",
    "dev:api": "node --watch backend/server.js",
    "dist": "electron-builder",
    "dist:linux": "electron-builder --linux",
    "dist:win": "electron-builder --win",
    "dist:win:dir": "electron-builder --win --dir",
    "test": "node --test"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "pg": "^8.23.0",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.jonattan.universalcamisasmotores",
    "productName": "Universal de Camisas para Motores",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*"
    ],
    "win": {
      "target": "nsis",
      "forceCodeSigning": false,
      "signAndEditExecutable": false
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "executableName": "universal-camisas-motores",
      "desktop": {
        "Name": "Universal de Camisas para Motores",
        "Comment": "Sistema de inventario y gestión de precios",
        "Categories": [
          "Utility",
          "Office"
        ]
      },
      "icon": "build/icons"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
