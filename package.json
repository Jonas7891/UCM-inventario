{
  "name": "universal-camisas-motores",
  "version": "1.0.0",
  "description": "Sistema de inventario y gestión de precios - Universal de Camisas para Motores",
  "main": "main.js",
  "author": "Jonattan",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.jonattan.universalcamisasmotores",
    "productName": "Universal de Camisas para Motores",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Utility",
      "executableName": "universal-camisas-motores",
      "icon": "build/icons",
      "desktop": {
        "Name": "Universal de Camisas para Motores",
        "Comment": "Sistema de inventario y gestión de precios",
        "Categories": ["Utility", "Office"]
      }
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
